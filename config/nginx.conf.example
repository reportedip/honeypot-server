server {
    listen 80;
    server_name your-honeypot.example.com;
    root /path/to/reportedip-honeypot-server/public;
    index index.php;

    # ---------------------------------------------------------------------
    # IMPORTANT: the honeypot only works if EVERY request reaches index.php.
    #
    # Default server hardening (common on managed hosting / control panels
    # like ISPConfig or Plesk) blocks dotfiles such as .env and .git with a
    # `location ~ /\.` deny rule, and serves robots.txt as a static file that
    # 404s when absent. Both are exactly the paths several traps rely on
    # (source-leak trap + honeytokens, spider trap), so they would never
    # reach the honeypot.
    #
    # The `^~` prefix and `=` exact locations below outrank any regex deny
    # rule and force these paths through index.php. They are deliberately
    # scoped to .env/.git/.svn so /.well-known (ACME/TLS) stays untouched.
    # ---------------------------------------------------------------------
    location ^~ /.env      { try_files /index.php =404; }
    location ^~ /.git      { try_files /index.php =404; }
    location ^~ /.svn      { try_files /index.php =404; }
    location = /robots.txt { try_files /index.php =404; }

    # ALL other requests go through index.php
    location / {
        try_files /index.php =404;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        include fastcgi_params;
    }

    # Block access to sensitive dirs
    location ~ ^/(src|config|data|tests|docker)/ {
        deny all;
    }
}
